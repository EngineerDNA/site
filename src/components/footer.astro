---
const currentYear = new Date().getFullYear();

const footerLinks = {
  product: [
    { href: '/', label: 'Home' },
    { href: '/how-it-works', label: 'How It Works' },
    { href: '/plugins', label: 'Plugins' },
  ],
  community: [
    { href: '/community', label: 'Community' },
    {
      href: 'https://github.com/engineerdna/engineerdna',
      label: 'GitHub',
      external: true,
    },
    {
      href: 'https://github.com/engineerdna/engineerdna/issues',
      label: 'Report Issue',
      external: true,
    },
  ],
  legal: [
    {
      href: 'https://www.apache.org/licenses/LICENSE-2.0',
      label: 'Apache 2.0 License',
      external: true,
    },
  ],
};
---

<footer class="border-t border-bg-secondary">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-1">
        <h3 class="mb-4 text-lg font-bold text-text-primary">EngineerDNA</h3>
        <p class="text-sm text-text-secondary">
          Open source engineering metrics platform. 100% free, Apache 2.0
          licensed.
        </p>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-semibold text-text-primary">Product</h4>
        <ul class="space-y-3">
          {
            footerLinks.product.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-secondary no-underline transition-colors hover:text-text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-semibold text-text-primary">Community</h4>
        <ul class="space-y-3">
          {
            footerLinks.community.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-secondary no-underline transition-colors hover:text-text-primary"
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-semibold text-text-primary">Legal</h4>
        <ul class="space-y-3">
          {
            footerLinks.legal.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-secondary no-underline transition-colors hover:text-text-primary"
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-bg-secondary pt-8">
      <p class="text-center text-sm text-text-secondary">
        {currentYear} EngineerDNA. Open source under Apache 2.0 License.
      </p>
    </div>
  </div>
</footer>
