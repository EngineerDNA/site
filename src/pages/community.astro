---
import BaseLayout from '../layouts/base-layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

const resources = [
  {
    title: 'GitHub Repository',
    description:
      'View source code, report issues, and contribute to EngineerDNA.',
    link: 'https://github.com/engineerdna/engineerdna',
    linkText: 'Visit Repository',
  },
  {
    title: 'Documentation',
    description:
      'Installation guides, plugin development, and API documentation.',
    link: 'https://github.com/engineerdna/engineerdna/wiki',
    linkText: 'Read Docs',
  },
  {
    title: 'Issues & Bugs',
    description: 'Report bugs, request features, or browse existing issues.',
    link: 'https://github.com/engineerdna/engineerdna/issues',
    linkText: 'View Issues',
  },
  {
    title: 'Discussions',
    description: 'Ask questions, share ideas, and connect with other users.',
    link: 'https://github.com/engineerdna/engineerdna/discussions',
    linkText: 'Join Discussions',
  },
];

const contributing = [
  {
    title: 'Code Contributions',
    description:
      'Submit pull requests for bug fixes, new features, or documentation improvements.',
  },
  {
    title: 'Plugin Development',
    description:
      'Build and share plugins for new integrations. Help expand the plugin ecosystem.',
  },
  {
    title: 'Bug Reports',
    description:
      'Report issues with detailed steps to reproduce. Include logs and environment details.',
  },
  {
    title: 'Documentation',
    description:
      'Improve installation guides, API docs, or create tutorials for new users.',
  },
];
---

<BaseLayout
  title="Community - EngineerDNA"
  description="Join the EngineerDNA community. Contribute code, report issues, and connect with other users."
>
  <Header />

  <main>
    <section class="px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h1 class="mb-6 text-5xl font-bold text-text-primary">Community</h1>
          <p class="mx-auto max-w-2xl text-xl text-text-secondary">
            EngineerDNA is 100% open source. Join the community to contribute,
            get help, and shape the future of the project.
          </p>
        </div>

        <div class="mb-20">
          <h2 class="mb-8 text-3xl font-bold text-text-primary">Resources</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {
              resources.map((resource) => (
                <div class="rounded-lg border border-bg-secondary bg-bg-secondary/50 p-6 transition-colors hover:border-text-secondary/30">
                  <h3 class="mb-3 text-xl font-semibold text-text-primary">
                    {resource.title}
                  </h3>
                  <p class="mb-4 text-text-secondary">{resource.description}</p>
                  <a
                    href={resource.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center text-accent-primary transition-colors hover:text-blue-400"
                  >
                    {resource.linkText}
                    <svg
                      class="ml-2 h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </a>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mb-20">
          <h2 class="mb-8 text-3xl font-bold text-text-primary">
            Ways to Contribute
          </h2>
          <div class="grid gap-6 md:grid-cols-2">
            {
              contributing.map((item) => (
                <div class="rounded-lg border border-bg-secondary bg-bg-secondary/50 p-6">
                  <h3 class="mb-3 text-xl font-semibold text-text-primary">
                    {item.title}
                  </h3>
                  <p class="text-text-secondary">{item.description}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="rounded-lg bg-bg-secondary p-8 text-center">
          <h2 class="mb-4 text-2xl font-bold text-text-primary">
            Apache 2.0 License
          </h2>
          <p class="mb-6 text-text-secondary">
            EngineerDNA is free and open source under the Apache 2.0 license.
            Use it commercially, modify it, distribute it.
          </p>
          <div
            class="flex flex-col items-center justify-center gap-4 sm:flex-row"
          >
            <a
              href="https://github.com/engineerdna/engineerdna"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-block no-underline"
            >
              View on GitHub
            </a>
            <a
              href="https://www.apache.org/licenses/LICENSE-2.0"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-block no-underline"
            >
              Read License
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
