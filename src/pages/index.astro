---
import BaseLayout from '../layouts/base-layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Hero from '../components/hero.astro';
import InstallButton from '../components/install-button';
---

<BaseLayout
  title="EngineerDNA - Open Source Engineering Metrics"
  description="Local web application with role-based dashboards for ICs, managers, and directors. Track goals, team health, and org-wide analytics. Runs on localhost:3847, data stays on your machine."
>
  <Header />

  <main>
    <Hero />

    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="relative">
          <div
            class="absolute inset-0 bg-gradient-to-r from-accent-primary/20 to-accent-secondary/20 blur-3xl"
          >
          </div>
          <div
            class="relative aspect-video rounded-lg border border-border bg-bg-tertiary shadow-2xl"
          >
            <div class="flex h-full items-center justify-center p-8 text-center">
              <div>
                <p class="mb-2 text-2xl font-semibold text-text-primary">
                  Manager Command Center Dashboard
                </p>
                <p class="text-text-tertiary">
                  Screenshot placeholder - Will be replaced before launch
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-bg-secondary px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-6 text-center text-4xl font-bold text-text-primary">
          Engineering metrics shouldn't require<br />
          a security review or a blank check
        </h2>

        <div class="mt-12 grid gap-8 md:grid-cols-3">
          <div class="text-center">
            <div class="mb-4 text-4xl">
              <svg
                class="mx-auto h-12 w-12 text-accent-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                ></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              Your SRE team blocks SaaS tools
            </h3>
            <p class="text-text-secondary">
              "We can't send pull request data to third-party servers."
            </p>
          </div>

          <div class="text-center">
            <div class="mb-4 text-4xl">
              <svg
                class="mx-auto h-12 w-12 text-accent-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              Tools cost $50-100/seat
            </h3>
            <p class="text-text-secondary">
              That's $15k/year for a 20-person team. For dashboards.
            </p>
          </div>

          <div class="text-center">
            <div class="mb-4 text-4xl">
              <svg
                class="mx-auto h-12 w-12 text-accent-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              No visibility across roles
            </h3>
            <p class="text-text-secondary">
              ICs can't track goals. Managers lack 1-on-1 prep. Directors fly
              blind on org health.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-6 text-center text-4xl font-bold text-text-primary">
          Everyone gets what they need
        </h2>
        <p class="mx-auto mb-16 max-w-3xl text-center text-xl text-text-secondary">
          Role-based dashboards with progressive access. 12 templates across 4
          roles, auto-created during onboarding.
        </p>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-lg border border-border bg-bg-secondary p-6">
            <div
              class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-accent-primary/20"
            >
              <svg
                class="h-6 w-6 text-accent-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              Individual Contributor
            </h3>
            <p class="mb-4 text-sm text-text-secondary">
              Personal Performance, My Activity
            </p>
            <ul class="mb-4 space-y-1 text-sm text-text-tertiary">
              <li>• Goal & skill tracking</li>
              <li>• Activity insights</li>
              <li>• Performance reviews</li>
            </ul>
            <p class="text-xs text-accent-secondary">
              Access: Your own metrics
            </p>
          </div>

          <div class="rounded-lg border border-border bg-bg-secondary p-6">
            <div
              class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-accent-primary/20"
            >
              <svg
                class="h-6 w-6 text-accent-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              Team Lead / Manager
            </h3>
            <p class="mb-4 text-sm text-text-secondary">
              Command Center, Weekly Briefing, Team Performance, Sprint
              Planning, Team Management
            </p>
            <ul class="mb-4 space-y-1 text-sm text-text-tertiary">
              <li>• Team health dashboard</li>
              <li>• 1-on-1 prep data</li>
              <li>• Sprint tracking</li>
            </ul>
            <p class="text-xs text-accent-secondary">
              Access: Team metrics + IC features
            </p>
          </div>

          <div class="rounded-lg border border-border bg-bg-secondary p-6">
            <div
              class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-accent-primary/20"
            >
              <svg
                class="h-6 w-6 text-accent-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              Director / VP
            </h3>
            <p class="mb-4 text-sm text-text-secondary">
              Executive Overview, Org Scorecard, Team Comparison, Cost & ROI,
              Capacity Planning
            </p>
            <ul class="mb-4 space-y-1 text-sm text-text-tertiary">
              <li>• Org-wide analytics</li>
              <li>• Cost analysis</li>
              <li>• Forecasting</li>
            </ul>
            <p class="text-xs text-accent-secondary">
              Access: Org-wide + Manager + IC features
            </p>
          </div>

          <div class="rounded-lg border border-border bg-bg-secondary p-6">
            <div
              class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-accent-primary/20"
            >
              <svg
                class="h-6 w-6 text-accent-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              Platform Admin
            </h3>
            <p class="mb-4 text-sm text-text-secondary">
              System Health, Data Management
            </p>
            <ul class="mb-4 space-y-1 text-sm text-text-tertiary">
              <li>• System configuration</li>
              <li>• Plugin management</li>
              <li>• Data quality</li>
            </ul>
            <p class="text-xs text-accent-secondary">
              Access: Full system + all user features
            </p>
          </div>
        </div>

        <div class="mt-12">
          <div
            class="relative aspect-video rounded-lg border border-border bg-bg-tertiary shadow-xl"
          >
            <div class="flex h-full items-center justify-center p-8 text-center">
              <div>
                <p class="mb-2 text-2xl font-semibold text-text-primary">
                  Role Selection Screen
                </p>
                <p class="text-text-tertiary">
                  Screenshot placeholder - Will be replaced before launch
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-bg-secondary px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-6 text-center text-4xl font-bold text-text-primary">
          How it works
        </h2>
        <p class="mx-auto mb-16 max-w-2xl text-center text-text-secondary">
          Three steps from installation to insights
        </p>

        <div class="space-y-12">
          <div class="flex gap-6">
            <div
              class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-accent-primary text-xl font-bold text-white"
            >
              1
            </div>
            <div class="flex-1">
              <h3 class="mb-2 text-xl font-semibold text-text-primary">
                Install and choose your role
              </h3>
              <p class="text-text-secondary">
                One binary for macOS, Linux, or Windows. Launches a local web
                server at localhost:3847. Select your role (IC, Manager,
                Director, Admin) and get auto-configured dashboards from
                templates.
              </p>
            </div>
          </div>

          <div class="flex gap-6">
            <div
              class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-accent-primary text-xl font-bold text-white"
            >
              2
            </div>
            <div class="flex-1">
              <h3 class="mb-2 text-xl font-semibold text-text-primary">
                Connect your tools
              </h3>
              <p class="text-text-secondary">
                Install plugins for GitHub, Jira, AWS Costs, or CSV imports.
                Use your own API keys (BYOK). Data syncs to local SQLite
                database with optional anonymization. Set manual or automatic
                sync schedules.
              </p>
            </div>
          </div>

          <div class="flex gap-6">
            <div
              class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-accent-primary text-xl font-bold text-white"
            >
              3
            </div>
            <div class="flex-1">
              <h3 class="mb-2 text-xl font-semibold text-text-primary">
                View your dashboards
              </h3>
              <p class="text-text-secondary">
                Role-based views with automatic updates every 30s-5m. Customize
                layouts with drag-and-drop. 22 widget types including charts,
                tables, alerts, goals, and team cards. Export to Google Sheets,
                Slack, or PDF.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-16 text-center">
          <a
            href="/how-it-works"
            class="inline-flex items-center gap-2 font-medium text-accent-primary hover:text-accent-primary/80"
          >
            See detailed architecture and workflows
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-16 text-center text-4xl font-bold text-text-primary">
          Built for sophisticated teams
        </h2>

        <div class="grid gap-8 md:grid-cols-3">
          <div class="rounded-lg bg-bg-secondary p-8">
            <svg
              class="mb-4 h-12 w-12 text-accent-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
            <h3 class="mb-4 text-xl font-semibold text-text-primary">
              Privacy-first architecture
            </h3>
            <p class="text-text-secondary">
              Localhost-only binding (127.0.0.1:3847). AES-256-GCM encryption
              for API keys. Three anonymization strategies. Comprehensive audit
              log. OS keychain integration.
            </p>
          </div>

          <div class="rounded-lg bg-bg-secondary p-8">
            <svg
              class="mb-4 h-12 w-12 text-accent-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
              ></path>
            </svg>
            <h3 class="mb-4 text-xl font-semibold text-text-primary">
              Extensible plugin SDK
            </h3>
            <p class="text-text-secondary">
              Three plugin types: Source (data in), Processor (transforms),
              Destination (data out). JSON-RPC over stdin/stdout. Plugin SDK
              for Go developers. Build custom integrations for any tool.
            </p>
          </div>

          <div class="rounded-lg bg-bg-secondary p-8">
            <svg
              class="mb-4 h-12 w-12 text-accent-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path>
            </svg>
            <h3 class="mb-4 text-xl font-semibold text-text-primary">
              Advanced insights and planning
            </h3>
            <p class="text-text-secondary">
              Goal tracking with OKRs. Alert system with threshold and anomaly
              detection. Skill development tracking. Cost & ROI analysis.
              Predictive forecasting for sprint completion and velocity.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <div
            class="rounded-lg border-l-4 border-accent-primary bg-bg-secondary p-6"
          >
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              Optional AI insights
            </h3>
            <p class="text-text-secondary">
              EngineerDNA works 100% without AI. The AI Insights processor
              plugin is optional and requires: (1) your own API key (Anthropic,
              OpenAI, or Ollama), (2) explicit anonymization of data before
              sending, (3) opt-in per dashboard widget. AI provides briefing
              summaries, talking points, anomaly explanations, and action
              recommendations when enabled.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-bg-secondary px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="mb-6 text-4xl font-bold text-text-primary">
          100% Open Source. Free forever.
        </h2>
        <p class="mb-12 text-xl text-text-secondary">
          Apache 2.0 licensed. No per-seat pricing. No vendor lock-in.
        </p>

        <div class="mb-12 grid gap-8 md:grid-cols-2">
          <div>
            <h3 class="mb-3 text-lg font-semibold text-text-primary">
              Go backend + React frontend
            </h3>
            <p class="text-text-secondary">
              Single binary distribution. Cross-platform support for macOS,
              Linux, and Windows. Embedded web server with browser-based UI.
            </p>
          </div>
          <div>
            <h3 class="mb-3 text-lg font-semibold text-text-primary">
              No pricing tiers or limits
            </h3>
            <p class="text-text-secondary">
              All features available to everyone. Unlimited engineers,
              dashboards, and plugins. No enterprise upsell. Community-driven
              development.
            </p>
          </div>
        </div>

        <a
          href="https://github.com/engineerdna/engineerdna"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary inline-flex items-center gap-2 no-underline"
        >
          <svg
            class="h-5 w-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"></path>
          </svg>
          View on GitHub
        </a>
      </div>
    </section>

    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="mb-6 text-4xl font-bold text-text-primary">
          Install in 60 seconds
        </h2>
        <p class="mb-12 text-text-secondary">
          Choose your installation method:
        </p>

        <div class="mb-8">
          <InstallButton client:load />
        </div>

        <p class="mt-8 text-sm text-text-tertiary">
          Then open <code class="rounded bg-bg-tertiary px-2 py-1 font-mono"
            >localhost:3847</code
          > in your browser
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
