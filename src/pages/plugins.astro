---
import BaseLayout from '../layouts/base-layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

const sourcePlugins = [
  {
    name: 'GitHub',
    description:
      'PRs, issues, commits, and reviews via GraphQL API. Supports story points from labels.',
    status: 'Available',
  },
  {
    name: 'AWS Costs',
    description:
      'Daily infrastructure costs and resource usage via Cost Explorer API.',
    status: 'Available',
  },
  {
    name: 'CSV Import',
    description:
      'Flexible column mapping for events, metrics, and attributes. Import from any CSV file.',
    status: 'Available',
  },
  {
    name: 'Jira',
    description: 'Issues, sprints, and project data from Jira.',
    status: 'Coming Soon',
  },
];

const processorPlugins = [
  {
    name: 'AI Insights',
    description:
      'Multi-provider support (Anthropic Claude, OpenAI GPT, Ollama). BYOK required. Mandatory anonymization.',
    status: 'Available',
    badge: 'Optional',
  },
];

const destinationPlugins = [
  {
    name: 'Google Sheets Export',
    description:
      'OAuth 2.0 integration for spreadsheet exports. Scheduled or manual exports.',
    status: 'Available',
  },
  {
    name: 'PDF Export',
    description:
      'Formatted reports with charts and tables. Professional documentation output.',
    status: 'Available',
  },
  {
    name: 'Markdown Export',
    description:
      'Documentation and changelog generation. Plain text format for version control.',
    status: 'Available',
  },
  {
    name: 'Slack',
    description: 'Real-time notifications and report delivery to Slack channels.',
    status: 'Coming Soon',
  },
];

const features = [
  {
    title: 'Three Plugin Types',
    description:
      'Source (data in), Processor (transforms), Destination (data out). Clear separation of concerns.',
  },
  {
    title: 'JSON-RPC Protocol',
    description:
      'Plugins communicate using JSON-RPC 2.0 over stdin/stdout. Subprocess isolation with configurable timeouts.',
  },
  {
    title: 'Plugin SDK for Go',
    description:
      'Build plugins in Go with the official SDK. Examples and documentation in GitHub repo.',
  },
  {
    title: 'Discovery System',
    description:
      'Plugins auto-discovered from ~/.engineerdna/plugins/ and ./plugins/ directories.',
  },
];
---

<BaseLayout
  title="Plugins - EngineerDNA"
  description="Built-in plugins for GitHub, AWS Costs, Google Sheets, PDF exports, and more. Extensible plugin SDK for custom integrations."
>
  <Header />

  <main>
    <section class="px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h1 class="mb-6 text-5xl font-bold text-text-primary">Plugins</h1>
          <p class="mx-auto max-w-2xl text-xl text-text-secondary">
            Three plugin types: Source (data in), Processor (transforms),
            Destination (data out). Use built-in plugins or build your own with
            the SDK.
          </p>
        </div>

        <div class="mb-20">
          <h2 class="mb-8 text-3xl font-bold text-text-primary">
            Source Plugins (Data IN)
          </h2>
          <p class="mb-8 text-text-secondary">
            Import events, metrics, and attributes from external systems
          </p>
          <div class="grid gap-6 md:grid-cols-2">
            {
              sourcePlugins.map((plugin) => (
                <div class="rounded-lg border border-bg-secondary bg-bg-secondary/50 p-6 transition-colors hover:border-text-secondary/30">
                  <div class="mb-3 flex items-center justify-between">
                    <h3 class="text-xl font-semibold text-text-primary">
                      {plugin.name}
                    </h3>
                    <span
                      class:list={[
                        'rounded-full px-3 py-1 text-xs font-medium',
                        plugin.status === 'Available'
                          ? 'bg-green-900/30 text-green-400'
                          : 'bg-yellow-900/30 text-yellow-400',
                      ]}
                    >
                      {plugin.status}
                    </span>
                  </div>
                  <p class="text-text-secondary">{plugin.description}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mb-20">
          <h2 class="mb-8 text-3xl font-bold text-text-primary">
            Processor Plugins (Transform)
          </h2>
          <p class="mb-8 text-text-secondary">
            Analyze, transform, and enhance your data
          </p>
          <div class="grid gap-6 md:grid-cols-2">
            {
              processorPlugins.map((plugin) => (
                <div class="rounded-lg border border-bg-secondary bg-bg-secondary/50 p-6 transition-colors hover:border-text-secondary/30">
                  <div class="mb-3 flex items-center justify-between">
                    <h3 class="text-xl font-semibold text-text-primary">
                      {plugin.name}
                    </h3>
                    <div class="flex gap-2">
                      {plugin.badge && (
                        <span class="rounded-full bg-accent-primary/20 px-3 py-1 text-xs font-medium text-accent-primary">
                          {plugin.badge}
                        </span>
                      )}
                      <span
                        class:list={[
                          'rounded-full px-3 py-1 text-xs font-medium',
                          plugin.status === 'Available'
                            ? 'bg-green-900/30 text-green-400'
                            : 'bg-yellow-900/30 text-yellow-400',
                        ]}
                      >
                        {plugin.status}
                      </span>
                    </div>
                  </div>
                  <p class="text-text-secondary">{plugin.description}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mb-20">
          <h2 class="mb-8 text-3xl font-bold text-text-primary">
            Destination Plugins (Data OUT)
          </h2>
          <p class="mb-8 text-text-secondary">
            Export data for stakeholders and reporting
          </p>
          <div class="grid gap-6 md:grid-cols-2">
            {
              destinationPlugins.map((plugin) => (
                <div class="rounded-lg border border-bg-secondary bg-bg-secondary/50 p-6 transition-colors hover:border-text-secondary/30">
                  <div class="mb-3 flex items-center justify-between">
                    <h3 class="text-xl font-semibold text-text-primary">
                      {plugin.name}
                    </h3>
                    <span
                      class:list={[
                        'rounded-full px-3 py-1 text-xs font-medium',
                        plugin.status === 'Available'
                          ? 'bg-green-900/30 text-green-400'
                          : 'bg-yellow-900/30 text-yellow-400',
                      ]}
                    >
                      {plugin.status}
                    </span>
                  </div>
                  <p class="text-text-secondary">{plugin.description}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mb-20">
          <h2 class="mb-8 text-3xl font-bold text-text-primary">
            Plugin Architecture
          </h2>
          <div class="grid gap-6 md:grid-cols-2">
            {
              features.map((feature) => (
                <div class="rounded-lg border border-bg-secondary bg-bg-secondary/50 p-6">
                  <h3 class="mb-3 text-xl font-semibold text-text-primary">
                    {feature.title}
                  </h3>
                  <p class="text-text-secondary">{feature.description}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="rounded-lg bg-bg-secondary p-8">
          <h2 class="mb-4 text-2xl font-bold text-text-primary">
            Build Your Own Plugin
          </h2>
          <p class="mb-6 text-text-secondary">
            Create custom plugins with the Plugin SDK for Go. JSON-RPC over
            stdin/stdout. Subprocess isolation with configurable timeouts. Full
            documentation and examples available on GitHub.
          </p>
          <div class="rounded-lg bg-bg-primary p-6">
            <p class="mb-2 font-mono text-sm text-text-secondary">
              Example: Plugin discovery
            </p>
            <code class="block font-mono text-sm text-text-primary">
              ~/.engineerdna/plugins/my-plugin/plugin.json
            </code>
          </div>
          <div class="mt-6">
            <a
              href="https://github.com/EngineerDNA/engineerdna#plugin-development"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-block no-underline"
            >
              View Plugin SDK Documentation
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
